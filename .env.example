# Copy to .env.local. Only needed for the optional Google Drive connector.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER=your-drive-folder-id

# Where the MCP server finds the running app (default http://localhost:3100).
SPOTLESS_URL=http://localhost:3100

# Set to 1 to run pipeline/run.ts without the LLM claim-extraction step.
SKIP_LLM=0
